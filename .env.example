# Optional. Without these the app stores models in IndexedDB only, and everything
# still works — cloud sync and the shared championship are the only things you lose.
#
# Create a project at https://console.firebase.google.com, add a Web app, then
# enable Firestore and, under Authentication → Sign-in method, the three ways in
# that the app offers: Anonymous, Google, and Email/Password. A provider left
# switched off is not a crash — the sign-in screen names it and the other two go
# on working. Copy this file to .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
