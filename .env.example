# Optional. Without these the app stores models in IndexedDB only, and everything
# still works — cloud sync is the only thing you lose.
#
# Create a project at https://console.firebase.google.com, add a Web app, then
# enable Firestore and Anonymous authentication. Copy this file to .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
